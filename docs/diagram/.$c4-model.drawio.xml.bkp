        <mxCell id="ov-model-brief" parent="ov-layer" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=middle;rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;spacing=18;" value="&lt;b&gt;Mô hình: Hướng sự kiện + Thread Pool + I/O bất đồng bộ không chặn&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lời gọi Hub, hết giờ và mất kết nối kích hoạt xử lý trên server.&lt;br&gt;.NET thread pool chạy tác vụ sẵn sàng; I/O đang chờ không giữ riêng luồng.&lt;br&gt;Hub chuyển hành động tới hàng đợi; trạng thái phòng nằm ngoài đối tượng Hub.&lt;br&gt;Mỗi phòng xử lý tuần tự; các phòng tiến triển đồng thời." vertex="1">
          <mxGeometry height="190" width="1650" x="40" y="140" as="geometry" />
        </mxCell>
<mxCell id="ov-signalr-note" value="&lt;b&gt;SignalR thay thế tầng TCP tự viết&lt;/b&gt;&lt;br&gt;SignalR quản lý transport và framing; WebSockets (WSS) khi khả dụng.&lt;br&gt;Hàng đợi gửi là cơ chế ứng dụng; không phải bảo đảm tự có của SignalR.&lt;br&gt;Gửi riêng theo kết nối / danh tính đã xác thực; nhóm không thay thế kiểm tra quyền.&lt;br&gt;Giới hạn queue, reconnect và chuyển chủ phòng còn mở. Chú giải bên dưới giữ nguyên từ phiên bản TCP trước." vertex="1" parent="ov-layer" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;align=left;"><mxGeometry as="geometry" x="70" y="2040" width="2560" height="150" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
