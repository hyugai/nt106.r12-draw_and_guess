<mxCell id="cp-title" value="&lt;b&gt;Draw &amp;amp; Guess — Thành phần máy chủ (C4 Component)&lt;/b&gt;" vertex="1" parent="AVTp8zRlv71y_wTY7c-L-1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;fontSize=24;align=left;"><mxGeometry as="geometry" x="850" y="30" width="2250" height="60" /></mxCell>
<mxCell id="cp-boundary" value="&lt;b&gt;Máy chủ trò chơi — C# / ASP.NET Core&lt;/b&gt;&lt;br&gt;Kiến trúc mục tiêu • một tiến trình" vertex="1" parent="AVTp8zRlv71y_wTY7c-L-1" style="swimlane;startSize=85;horizontal=1;fillColor=none;strokeColor=#1168bd;dashed=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=12;"><mxGeometry as="geometry" x="850" y="340" width="2250" height="1770" /></mxCell>
<mxCell id="cp-auth" value="&lt;b&gt;Xác thực và phiên&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Minimal API: tài khoản và phiên chơi.&lt;br&gt;Kiểm tra danh tính / quyền truy cập." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="70" y="130" width="480" height="180" /></mxCell>
<mxCell id="cp-hub" value="&lt;b&gt;Cổng gameplay SignalR&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Nhận lời gọi Hub đã xác thực.&lt;br&gt;Kiểm tra dữ liệu và định tuyến phòng.&lt;br&gt;Không giữ trạng thái phòng trong Hub." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="880" y="130" width="480" height="180" /></mxCell>
<mxCell id="cp-delivery" value="&lt;b&gt;Lọc và phân phối sự kiện&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Từ khóa / gợi ý / vai ẩn gửi riêng.&lt;br&gt;Hàng đợi ứng dụng có giới hạn.&lt;br&gt;Gửi tuần tự qua IHubContext." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="1690" y="130" width="480" height="180" /></mxCell>
<mxCell id="cp-rooms" value="&lt;b&gt;Sảnh và quản lý phòng&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Tạo / vào / rời phòng, cấu hình,&lt;br&gt;thành viên và quyền chủ phòng.&lt;br&gt;Chuyển thay đổi tới bộ xử lý phòng." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="880" y="500" width="480" height="180" /></mxCell>
<mxCell id="cp-normal" value="&lt;b&gt;Luật Vẽ đoán&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Quyền vẽ, kiểm tra đáp án,&lt;br&gt;kết thúc lượt và điểm theo luật chốt.&lt;br&gt;Công thức điểm còn mở." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="70" y="880" width="480" height="180" /></mxCell>
<mxCell id="cp-match" value="&lt;b&gt;Bộ xử lý phòng và điều phối trận&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Một hàng đợi tuần tự cho mỗi phòng.&lt;br&gt;Giai đoạn, lượt, deadline và chuyển vòng.&lt;br&gt;Nhận cả sự kiện hết giờ / mất kết nối." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="880" y="880" width="480" height="180" /></mxCell>
<mxCell id="cp-imposter" value="&lt;b&gt;Luật Imposter&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Vai ẩn; từ khóa / gợi ý riêng.&lt;br&gt;Hai lượt vẽ đảo thứ tự, thảo luận, vote.&lt;br&gt;Hòa phiếu / điểm còn mở." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="1690" y="880" width="480" height="180" /></mxCell>
<mxCell id="cp-canvas" value="&lt;b&gt;Quản lý canvas&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Kiểm tra quyền và đóng góp nét vẽ.&lt;br&gt;Giữ trạng thái canvas, chủ sở hữu nét.&lt;br&gt;Khóa vẽ theo giai đoạn / lượt." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="70" y="1270" width="480" height="180" /></mxCell>
<mxCell id="cp-keywords" value="&lt;b&gt;Chọn từ khóa và gợi ý&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;Chọn từ hệ thống cho từng vòng.&lt;br&gt;Cặp đáp án — gợi ý được chuẩn bị.&lt;br&gt;Không để chủ phòng cung cấp đáp án." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="880" y="1270" width="480" height="180" /></mxCell>
<mxCell id="cp-data" value="&lt;b&gt;Truy cập dữ liệu&lt;/b&gt;&lt;br&gt;[Thành phần: C# / .NET]&lt;br&gt;&lt;br&gt;EF Core / SQL Server provider.&lt;br&gt;Đọc tài khoản, từ khóa và gợi ý.&lt;br&gt;Lưu kết quả trận bất đồng bộ." vertex="1" parent="cp-boundary" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;rounded=0;fillColor=#438dd5;strokeColor=#1168bd;fontColor=#ffffff;"><mxGeometry as="geometry" x="1690" y="1270" width="480" height="180" /></mxCell>
<mxCell id="cp-client" value="&lt;b&gt;Ứng dụng người chơi&lt;/b&gt;&lt;br&gt;[Container: C# / WinForms]&lt;br&gt;SignalR .NET Client" vertex="1" parent="AVTp8zRlv71y_wTY7c-L-1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;"><mxGeometry as="geometry" x="1730" y="140" width="480" height="130" /></mxCell>
<mxCell id="cp-db" value="&lt;b&gt;Cơ sở dữ liệu trò chơi&lt;/b&gt;&lt;br&gt;[Container: Microsoft SQL Server]&lt;br&gt;Tài khoản, từ khóa / gợi ý, kết quả" vertex="1" parent="AVTp8zRlv71y_wTY7c-L-1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;"><mxGeometry as="geometry" x="3210" y="1610" width="480" height="180" /></mxCell>
<mxCell id="cp-notes" value="&lt;b&gt;Quy tắc thiết kế&lt;/b&gt;&lt;br&gt;Thành phần là trách nhiệm logic, không phải service hay thread riêng.&lt;br&gt;Trạng thái phòng ở bộ nhớ; khởi động lại server kết thúc trận đang chơi.&lt;br&gt;Kết quả DB ảnh hưởng trạng thái phải áp dụng đúng thứ tự trong phòng.&lt;br&gt;Luật chưa chốt, reconnect và chuyển chủ phòng chưa được xác định." vertex="1" parent="AVTp8zRlv71y_wTY7c-L-1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=12;align=left;"><mxGeometry as="geometry" x="920" y="1930" width="2050" height="140" /></mxCell>
