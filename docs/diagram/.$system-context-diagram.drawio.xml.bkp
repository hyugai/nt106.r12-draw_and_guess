        </mxCell>
        <mxCell id="ov-pool" parent="ov-layer" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;spacing=12;fontSize=17;" value="&lt;b&gt;.NET Thread Pool — shared execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker 1 &amp;nbsp; • &amp;nbsp; Worker 2 &amp;nbsp; • &amp;nbsp; … &amp;nbsp; • &amp;nbsp; Worker N&lt;br&gt;Runs ready receive/send continuations and room-processing work.&lt;br&gt;Pending I/O does not reserve a worker. No dedicated thread per client." vertex="1">
