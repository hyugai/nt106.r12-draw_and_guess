          <mxGeometry height="40" width="2600" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ov-boundary" parent="ov-layer" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#667085;strokeWidth=2;align=left;verticalAlign=top;spacingTop=20;spacingLeft=20;" value="&lt;b&gt;Game Server — one ASP.NET Core process&lt;/b&gt;" vertex="1">
