        </mxCell>
        <mxCell id="ov-clients" parent="ov-layer" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;align=center;verticalAlign=middle;rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;spacing=12;verticalAlign=top;spacingTop=15;" value="&lt;b&gt;WinForms clients&lt;/b&gt;" vertex="1">
